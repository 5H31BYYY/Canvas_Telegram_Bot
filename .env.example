# ============================================================
# 1. TELEGRAM CONFIGURATION (Required)
# ============================================================
# Create a bot via @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=

# Run `python bot.py --get-chat-id` after messaging your bot to find this.
TELEGRAM_CHAT_ID=

# Enable interactive commands & buttons (/check, /upcoming, /courses, /status, /help, /chatid)
TELEGRAM_ENABLE_COMMANDS=true

# ============================================================
# 2. POLLING & ALERT SETTINGS
# ============================================================
# Polling interval in seconds when running in daemon mode (`python bot.py`).
POLL_SECONDS=300

# Local timezone for displaying deadlines, events & digest timestamps.
TIMEZONE=Asia/Phnom_Penh

# Group alerts from each poll into one clean Telegram digest (true recommended, like MS Teams bot).
DIGEST_MODE=true

# Prevent spam on the very first run by recording existing items silently (false recommended).
ALERT_ON_FIRST_RUN=false

# Multi-tier reminder lead times (comma-separated minutes before deadline/event start)
ASSIGNMENT_REMINDER_MINUTES=1440,180,60
EVENT_REMINDER_MINUTES=30,15

# How many days ahead to cache & display in /upcoming
UPCOMING_LOOKAHEAD_DAYS=7

# Optional quiet hours in HH:MM-HH:MM (24h local time, e.g. 23:00-07:00).
# Alerts during quiet hours are deferred and delivered together once quiet hours end.
QUIET_HOURS=
